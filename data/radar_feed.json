ww.investing.com/news/stock-market-news/australia-targets-social-media-algorithms-with-new-userchoice-rules-4890784","tier":2,"publishedAt":"2026-09-08T04:19:04.000Z"}],"bestTier":2,"firstSource":"All News","firstAt":"2026-09-08T04:19:04.000Z","hid":"h1p5alwy","cat":"TRH","cb":false,"cs":"","ai":"","story":"","affects":[],"score":3,"milestone":""},{"_tier":2,"id":"rh1tc91j6","provider":"rss","source":"ActionForex","headline":"Yen Rally Accelerates on Strong Japan Data, AUD/JPY and NZD/JPY Break Down for Different Reasons","url":"https://www.actionforex.com/action-insight/market-overview/653310-yen-rally-accelerates-on-strong-japan-data-aud-jpy-and-nzd-jpy-break-down-for-different-reasons/","isAnalysis":true,"publishedAt":"2026-09-08T03:45:25.000Z","image":"https://www.actionforex.com/wp-content/uploads/2021/09/f-jpy161.jpg","srcCount":1,"sources":[{"source":"ActionForex","url":"https://www.actionforex.com/action-insight/market-overview/653310-yen-rally-accelerates-on-strong-japan-data-aud-jpy-and-nzd-jpy-break-down-for-different-reasons/","tier":2,"publishedAt":"2026-09-08T03:45:25.000Z"}],"bestTier":2,"firstSource":"ActionForex","firstAt":"2026-09-08T03:45:25.000Z","hid":"h12ov72h","cat":"MAKRO","cb":false,"cs":"","ai":"","story":"","affects":[["JPY"],["AUD"],["NZD"]],"score":3,"milestone":""}],"conns":[{"tag":"Japonská ekonomika a BOJ","text":"Zprávy o silnějším než očekávaném růstu HDP a výrazném nárůstu reálných i celkových mezd v Japonsku (zprávy 1, 2, 3, 7, 8) naznačují robustní ekonomické oživení. Tyto pozitivní údaje posilují argumenty pro Bank of Japan k přehodnocení ultra-uvolněné měnové politiky a potenciálnímu zvýšení sazeb.","pairs":["Japan Q2 GDP beats forecast","Japan July real wages rise","Japan wages data, July","Japan revises Q2 GDP up","Japan revised Q2 GDP: +1.4%"]},{"tag":"Globální inflace a spotřebitelé","text":"Zprávy o rostoucí inflaci v Kolumbii (zpráva 4) a nárůstu cen ropy po incidentu v Saúdské Arábii (zpráva 6) poukazují na přetrvávající inflační tlaky. Tyto tlaky, společně s dopady úrokových sazeb a cen pohonných hmot, negativně ovlivňují spotřebitelskou náladu, jak je patrné z Austrálie (zpráva 11).","pairs":["Colombia 12-month inflation","Oil prices climb","Australian consumer sentiment slides"]}],"desk":{"title":"Silná japonská data zvyšují tlak na BOJ","summary":"Japonská ekonomika dnes ukázala silnější než očekávané známky oživení, což výrazně posiluje spekulace o možném zpřísnění měnové politiky Bank of Japan. Revidovaný růst HDP za druhé čtvrtletí na anualizovaných 1,4 % a především robustní nárůst reálných mezd o 2,4 % v červenci, největší od roku 2021, naznačují udržitelnější inflační tlaky a silnější domácí poptávku. Přestože tato data podporují jestřábí narativ, Bank of Japan se dlouhodobě drží ultra-uvolněné politiky a bude pečlivě vyhodnocovat udržitelnost těchto trendů před jakoukoli změnou. Investoři se nyní zaměří na další inflační zprávy a budoucí komentáře představitelů BOJ, aby získali jasnější představu o načasování potenciálního posunu.","points":[["Co se změnilo","Japonský HDP za Q2 byl revidován výše na anualizovaných 1,4 % (původně 1,1 %). Reálné mzdy v červenci vzrostly o 2,4 % r/r, což je největší nárůst od roku 2021, a celkové výdělky překonaly očekávání s růstem o 4,7 % r/r. Tyto údaje posilují argumenty pro možnou změnu měnové politiky Bank of Japan."],["Protiargument","Bank of Japan je známá svou opatrností a dlouhodobým závazkem k ultra-uvolněné politice. K potvrzení udržitelnosti inflačních tlaků a mzdového růstu bude potřeba více dat a jasnější signály."],["Co sledovat dál","Trhy budou bedlivě sledovat další inflační zprávy z Japonska a jakékoli komentáře či projevy představitelů Bank of Japan, které by mohly naznačit budoucí směřování měnové politiky."]],"updatedAt":"2026-09-08T00:58:05.847Z","sources":[{"headline":"Japan Q2 GDP beats forecast, supporting case for BOJ rate hike","url":"https://www.investing.com/news/economic-indicators/japan-q2-gdp-beats-forecast-supporting-case-for-boj-rate-hike-4890750","source":"All News"},{"headline":"Japan July real wages rise 2.4%, biggest gain since 2021","url":"https://www.investing.com/news/economy-news/japan-july-real-wages-rise-24-biggest-gain-since-2021-4890748","source":"All News"},{"headline":"Japan wages data, July 2026: Headline earnings +4.7% y/y (expected +3.9%, prior +4%)","url":"https://investinglive.com/news/japan-wages-data-july-2026-headline-earnings-4-7-y-y-expected-3-9-prior-4/","source":"Investinglive RSS Breaking News Feed"},{"headline":"Colombia 12-month inflation edges up more than expected in August","url":"https://www.investing.com/news/economy-news/colombia-12month-inflation-edges-up-more-than-expected-in-august-4890747","source":"All News"},{"headline":"Euro holds gains above 1.1600 on ECB tightening prospects","url":"https://www.fxstreet.com/news/euro-holds-gains-above-11600-on-ecb-tightening-prospects-202609080039","source":"FXStreet Forex & Commodities News"}]},"hasAI":true}