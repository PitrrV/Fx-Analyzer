":"h1134xns","cat":"CENTRÁLNÍ BANKA","cb":true,"cs":"Piero Cipollone: Pontes a Appia: odemykání příležitostí pro banky","ai":"Člen Výkonné rady ECB Piero Cipollone naznačuje, že iniciativy 'Pontes a Appia' mají potenciál otevřít nové příležitosti pro banky, což by mohlo vést k inovacím nebo efektivitě v bankovním sektoru.","story":"Tato zpráva zapadá do širšího příběhu o snaze centrálních bank podporovat rozvoj a stabilitu finančního sektoru prostřednictvím nových iniciativ.","affects":[["EUR","neu"]],"score":4,"milestone":"","analyzedAt":"2026-10-21T08:00:59.662Z"},{"_tier":2,"id":"rh1ff3djf","provider":"rss","source":"ActionForex","headline":"Pound vs Dollar: Who Wins Amid the Energy Shock?","url":"https://www.actionforex.com/contributors/technical-analysis/658257-pound-vs-dollar-who-wins-amid-the-energy-shock/","isAnalysis":true,"publishedAt":"2026-10-21T11:10:49.000Z","image":"https://www.actionforex.com/wp-content/uploads/2023/06/f-gbp176.jpg","srcCount":1,"sources":[{"source":"ActionForex","url":"https://www.actionforex.com/contributors/technical-analysis/658257-pound-vs-dollar-who-wins-amid-the-energy-shock/","tier":2,"publishedAt":"2026-10-21T11:10:49.000Z"}],"bestTier":2,"firstSource":"ActionForex","firstAt":"2026-10-21T11:10:49.000Z","hid":"h1whnu4g","cat":"TRH","cb":false,"cs":"","ai":"","story":"","affects":[["USD"],["GBP"]],"score":3,"milestone":""},{"_tier":2,"id":"rhhxs241","provider":"rss","source":"ActionForex","headline":"EURCAD Wave Analysis","url":"https://www.actionforex.com/contributors/technical-analysis/658246-eurcad-wave-analysis-57/","isAnalysis":true,"publishedAt":"2026-10-21T11:07:42.000Z","image":"https://www.actionforex.com/wp-content/uploads/2018/05/f-eur-cad1.jpg","srcCount":1,"sources":[{"source":"ActionForex","url":"https://www.actionforex.com/contributors/technical-analysis/658246-eurcad-wave-analysis-57/","tier":2,"publishedAt":"2026-10-21T11:07:42.000Z"}],"bestTier":2,"firstSource":"ActionForex","firstAt":"2026-10-21T11:07:42.000