:45.000Z","image":"https://content-media.investing.com/news/LYNXMPEM1J0WY_1200_L.jpg","srcCount":1,"sources":[{"source":"All News","url":"https://www.investing.com/news/stock-market-news/black-friday-ends-soon-only-hours-to-go-to-secure-60-off-investingpro-5053549","tier":2,"publishedAt":"2026-11-27T13:56:45.000Z"}],"bestTier":2,"firstSource":"All News","firstAt":"2026-11-27T13:56:45.000Z","hid":"hyxfc","cat":"TRH","cb":false,"cs":"","ai":"","story":"","affects":[],"score":3,"milestone":""},{"_tier":2,"id":"rh1v4u417","provider":"rss","source":"ActionForex","headline":"US Goods Trade Deficit Widens to $149.5B as Capital Goods Imports Surge","url":"https://www.actionforex.com/live-comments/662315-us-goods-trade-deficit-widens-to-149-5b-as-capital-goods-imports-surge/","isAnalysis":true,"publishedAt":"2026-11-27T13:38:20.000Z","image":"https://www.actionforex.com/wp-content/uploads/featured-images/f-usa4.jpg","srcCount":1,"sources":[{"source":"ActionForex","url":"https://www.actionforex.com/live-comments/662315-us-goods-trade-deficit-widens-to-149-5b-as-capital-goods-imports-surge/","tier":2,"publishedAt":"2026-11-27T13:38:20.000Z"}],"bestTier":2,"firstSource":"ActionForex","firstAt":"2026-11-27T13:38:20.000Z","hid":"h1g61nqc","cat":"TRH","cb":false,"cs":"","ai":"","story":"","affects":[],"score":3,"milestone":""},{"_tier":1,"id":"cbh1ktf6se","provider":"cb","source":"Bank of England","headline":"Statistical Notice 2026/09 - Update to the classification of accounts guide","url":"https://www.bankofengland.co.uk/statistics/notice/2026/statistical-notice-2026-09","publishedAt":"2026-11-26T12:33:57.000Z","image":"","srcCount":1,"sources":[{"source":"Bank of England","url":"https://www.bankofengland.co.uk/statistics/notice/2026/statistical-notice-2026-09","tier":1,"publishedAt":"2026-11-26T12:33:57.000Z"}],"bestTier":1,"firstSource":"Bank of England","firstAt":"2026-11-26T12:33:57.000Z","isAnalysis":false,"hid":"hilg38g","cat":"CENTRÁLNÍ BANKA","cb":true,"cs":"Statistické oznámení 2026/09 - Aktualizace průvodce klasifikací účtů","ai":"Bank of England vydala aktualizaci svého průvodce pro klasifikaci účtů, což je rutinní administrativní a statistická záležitost.","story":"Tato zpráva se týká interních administrativních a statistických procesů centrální banky, které zajišťují transparentnost a správnost dat.","affects":[],"score":1,"milestone":"","analyzedAt":"2026-11-26T14:46:26.756Z"}],"conns":[{"tag":"Eurozóna: Stagnace a Inflace","text":"Ekonomická aktivita v eurozóně vykazuje známky zpomalení, s Francií v technické recesi a poklesem celkové důvěry. Současně však spotřebitelská inflační očekávání zůstávají zvýšená, což potvrzuje i průzkum ECB.","pairs":["France in technical recession after quarterly revisions (All News, skóre 9)","Eurozone Sentiment Falls to 95.8 as Industrial Confidence and Hiring Outlook Weaken (ActionForex, skóre 7)","Eurozone Inflation Expectations Rise Sharply, Five-Year Outlook Stays at Record High (ActionForex, skóre 8)","ECB Consumer Expectations Survey results – October 2026 (ECB, skóre 8)"]},{"tag":"Dopady Vysokých Sazeb na Spotřebitele","text":"Vysoké úrokové sazby ovlivňují klíčové sektory, jako je americký trh s bydlením, kde dochází ke zpomalení prodejů. Zároveň se spotřebitelé potýkají s omezenými rozpočty, což se projeví i během nákupní sezóny Black Friday.","pairs":["US housing market 2026: high rates, slow sales, and a buyer’s dilemma (All News, skóre 7)","Explainer-Black Friday test for retailers as tight budgets meet AI-savvy shoppers (All News, skóre 4)"]}],"desk":{"title":"ECB a inflace v centru pozornosti: Trhy vyhodnocují budoucí směr sazeb","summary":"Trhy se dnes soustředí na výhled měnové politiky Evropské centrální banky a přetrvávající inflační tlaky. Investoři bedlivě sledují signály ohledně budoucího směřování úrokových sazeb, které ovlivňují náklady na kapitál a ekonomický růst. Zápis z posledního zasedání ECB posílil očekávání prosincového zvýšení sazeb, přičemž výsledky průzkumu spotřebitelských očekávání poskytují další kontext k inflačním tlakům. Nicméně, jeden z představitelů ECB naznačil, že dosavadní zvýšení sazeb nemusí být dostatečné k dosažení 2% inflačního cíle, což naznačuje přetrvávající nejistotu. Dále bude klíčové sledovat vývoj inflačních dat a komunikaci centrálních bankéřů, stejně jako dopad geopolitických událostí na ceny komodit.","points":[["Co se změnilo","Zápis z jednání ECB posílil očekávání prosincového zvýšení sazeb, což potvrzuje jestřábí směřování měnové politiky. Průzkum spotřebitelských očekávání ECB poskytl aktuální data o vnímání inflace a ekonomického vývoje veřejností."],["Protiargument","Oficiální vyjádření z ECB naznačuje, že dosavadní zvýšení sazeb nemusí být dostatečné k dosažení inflačního cíle 2%, což podtrhuje přetrvávající inflační výzvy. Ropa směřuje k ukončení tří týdnů poklesu kvůli obavám z dodávek, což by mohlo představovat další proinflační tlak."],["Co sledovat dál","Další inflační data z eurozóny a komunikaci představitelů ECB ohledně budoucího nastavení měnové politiky. Vývoj na globálních komoditních trzích, zejména ceny ropy, a jejich potenciální dopad na inflační očekávání. Širší tržní sentiment, včetně vývoje akciových trhů a výnosů státních dluhopisů, které reflektují očekávání ohledně ekonomického růstu a úrokových sazeb."]],"updatedAt":"2026-11-27T13:16:54.628Z","sources":[{"headline":"Hawkish ECB Minutes Reinforce Expectations of a December Rate Hike","url":"https://www.actionforex.com/contributors/fundamental-analysis/662298-hawkish-ecb-minutes-reinforce-expectations-of-a-december-rate-hike/","source":"ActionForex"},{"headline":"ECB rate hikes not enough to hit 2% inflation target, official says","url":"https://www.investing.com/news/economy-news/ecb-rate-hikes-not-enough-to-hit-2-inflation-target-official-says-5053475","source":"All News"},{"headline":"Oil on track to snap three-week losing streak over supply fears","url":"https://www.investing.com/news/commodities-news/brent-trades-near-months-high-as-mideast-conflict-threatens-supply-5052810","source":"All News"},{"headline":"ECB Consumer Expectations Survey results – October 2026","url":"https://www.ecb.europa.eu//press/pr/date/2026/html/ecb.pr261127~2e53af695e.en.html","source":"ECB"},{"headline":"Stocks and Metals Rally as China Lifts Sentiment, but FX Rebound Defies Monthly Trend","url":"https://www.actionforex.com/action-insight/market-overview/662308-stocks-and-metals-rally-as-china-lifts-sentiment-but-fx-rebound-defies-monthly-trend/","source":"ActionForex"}]},"hasAI":true}