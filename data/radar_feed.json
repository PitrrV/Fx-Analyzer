[{"source":"ActionForex","url":"https://www.actionforex.com/live-comments/658901-us-durable-goods-orders-rise-1-8-but-aircraft-drive-much-of-the-strength/","tier":2,"publishedAt":"2026-10-27T12:45:08.000Z"}],"bestTier":2,"firstSource":"ActionForex","firstAt":"2026-10-27T12:45:08.000Z","hid":"hchwd5n","cat":"TRH","cb":false,"cs":"","ai":"","story":"","affects":[],"score":3,"milestone":""}],"conns":[{"tag":"Posilování Dolaru a Centrální Banky","text":"Zprávy o posilování dolaru (1, 2) jsou spojeny s očekáváním ohledně sazeb Fedu a nadcházejícími zasedáními centrálních bank. Současně zprávy ECB (5, 7) naznačují zpřísňování úvěrových podmínek v eurozóně, což může vést k odlišným ekonomickým vyhlídkám a podpořit sílu dolaru.","pairs":["EUR/USD, Fed Rate","Dollar, Central Banks","ECB, Lending Conditions","ECB, Bank Lending Survey"]},{"tag":"Obavy ze Stagflace a Ekonomické Zpomalení","text":"Zpráva o potenciální stagflaci kvůli cenám ropy (3) je podpořena smíšenými daty o objednávkách zboží dlouhodobé spotřeby v USA (4), naznačujícími nerovnoměrný růst. Zpřísňování úvěrových podmínek v eurozóně (5, 7) dále signalizuje možné ekonomické zpomalení, což posiluje obavy ze stagnace.","pairs":["Brent, Stagflation","Durable Goods","ECB, Lending Conditions","ECB, Bank Lending Survey"]}],"desk":{"title":"Evropské trhy pod tlakem zpřísňování finančních podmínek","summary":"Evropské trhy dnes čelí tlaku, taženy obavami z ekonomického zpomalení a zpřísňování finančních podmínek. Investoři pozorně sledují dopady vyšších úrokových sazeb na podnikové úvěry a spotřebitelskou poptávku, což ovlivňuje celkový sentiment. To pramení z dat jako je průzkum ECB o přístupu podniků k financování, který ukázal zpřísnění úvěrových podmínek, a také z poklesu evropských akcií, kde se projevily obavy z energetiky a výsledky firem jako HSBC. Naopak, některé sektory a regiony vykazují odolnost, například růst prodejů polovodičů v Číně nebo silné výsledky jednotlivých společností jako Porsche či Sobi, které těží z cenové síly. Dále bude klíčové sledovat budoucí komunikaci ECB, včetně rozhovorů s jejími představiteli a výsledků průzkumů spotřebitelských očekávání, pro indikaci dalšího vývoje monetární politiky a ekonomiky.","points":[["Co se změnilo","Evropské akcie klesají v důsledku obav z energetiky a firemních výsledků (HSBC). Průzkum ECB ukázal zpřísnění úvěrových podmínek pro podniky."],["Protiargument","Růst prodejů polovodičů v Číně naznačuje odolnost v technologickém sektoru. Některé společnosti (Porsche, Sobi) vykazují silné finanční výsledky a zvyšují výhledy."],["Co sledovat dál","Další data z průzkumů ECB (spotřebitelská očekávání, přístup k financování) a komentáře představitelů ECB k monetární politice a ekonomickému vývoji."]],"updatedAt":"2026-10-27T08:31:55.813Z","sources":[{"headline":"European shares fall as HSBC slump and energy fears offset AI glow","url":"https://www.investing.com/news/stock-market-news/european-shares-fall-as-hsbc-slump-and-energy-fears-offset-ai-glow-4974295","source":"All News"},{"headline":"Survey on the Access to Finance of Enterprises: lending conditions tightened","url":"https://www.ecb.europa.eu//press/pr/date/2026/html/ecb.pr261026~bde7b6d11a.en.html","source":"ECB"},{"headline":"Piero Cipollone: Interview with Milano Finanza","url":"https://www.ecb.europa.eu//press/inter/date/2026/html/ecb.in261024~ee2ba73cf3.en.html","source":"ECB"},{"headline":"ECB Consumer Expectations Survey results – September 2026","url":"https://www.ecb.europa.eu//press/pr/date/2026/html/ecb.pr261023~a3d201c97c.en.html","source":"ECB"},{"headline":"BofA: China core semiconductor sales rise 24% in June-August","url":"https://www.investing.com/news/stock-market-news/bofa-china-core-semiconductor-sales-rise-24-in-juneaugust-93CH-4974383","source":"All News"}]},"hasAI":true}