-content/uploads/pair-images/eurusd.jpg","srcCount":1,"sources":[{"source":"ActionForex","url":"https://www.actionforex.com/technical-outlook/eurusd-outlook/656737-eur-usd-daily-outlook-2501/","tier":2,"publishedAt":"2026-10-07T11:45:10.000Z"}],"bestTier":2,"firstSource":"ActionForex","firstAt":"2026-10-07T11:45:10.000Z","hid":"hx1rbre","cat":"TRH","cb":false,"cs":"Denní výhled EUR/USD.","ai":"Bez interpretace.","story":"","affects":[],"score":1,"milestone":"","analyzedAt":"2026-09-25T12:17:48.192Z"},{"_tier":2,"id":"rh2c2l7w","provider":"rss","source":"ActionForex","headline":"AUD/USD Daily Report","url":"https://www.actionforex.com/technical-outlook/audusd-outlook/656721-aud-usd-daily-report-1765/","isAnalysis":true,"publishedAt":"2026-10-07T11:13:44.000Z","image":"https://www.actionforex.com/wp-content/uploads/pair-images/audusd.jpg","srcCount":1,"sources":[{"source":"ActionForex","url":"https://www.actionforex.com/technical-outlook/audusd-outlook/656721-aud-usd-daily-report-1765/","tier":2,"publishedAt":"2026-10-07T11:13:44.000Z"}],"bestTier":2,"firstSource":"ActionForex","firstAt":"2026-10-07T11:13:44.000Z","hid":"hv6j7s5","cat":"TRH","cb":false,"cs":"Denní zpráva AUD/USD.","ai":"Bez interpretace.","story":"","affects":[],"score":1,"milestone":"","analyzedAt":"2026-09-25T12:17:48.192Z"}],"conns":[{"tag":"Obavy z ekonomiky eurozóny","text":"Zprávy naznačují oslabení eura v reakci na varování představitelů ECB před ekonomickým zpomalením. Pokles prodejů Mercedes-Benz v Číně dále podtrhuje širší ekonomické obavy, které ovlivňují sentiment na trhu s eurem.","pairs":["EUR","ECB","Eurozóna","Mercedes-Benz"]},{"tag":"Rozdílné postoje centrálních bank","text":"Centrální banky signalizují odlišné postoje: NBP je opatrná kvůli inflaci, zatímco BOJ zní méně holubičí. Trhy zároveň čekají na zápisky Fedu a ECB varuje před zpomalením, což vytváří divergenci v měnové politice.","pairs":["NBP","BOJ","Fed","ECB","PLN","EUR/USD"]}],"desk":{"title":"Trhy v očekávání Fedu: Dolar posiluje, zlato klesá","summary":"Trhy s napětím očekávají zveřejnění zápisu z posledního zasedání Federálního rezervního systému, který by měl nabídnout vodítka k budoucí měnové politice USA. Tato nejistota a očekávání vedou k posilování amerického dolaru a růstu výnosů státních dluhopisů, což tlačí na cenu zlata, které se blíží dvouměsíčním minimům, jak uvádí FXStreet. Naopak v eurozóně se objevují signály, že Evropská centrální banka (ECB) zatím nevidí druhotné inflační efekty, což potvrdil i Pereira z ECB. Euro mezitím nadále oslabuje, ovlivněno i přetrvávajícími obavami z francouzských dluhopisů. Investoři budou pečlivě sledovat tón zápisu Fedu a jeho dopad na globální měnové trhy a komodity.","points":[["Co se změnilo","Americký dolar posiluje a výnosy státních dluhopisů rostou v očekávání zápisu Fedu, což tlačí na cenu zlata k dvouměsíčním minimům. Euro oslabuje, ovlivněno i přetrvávajícími obavami z francouzských dluhopisů."],["Protiargument","Člen ECB Pereira naznačil, že v eurozóně zatím nejsou patrné druhotné inflační efekty, což může snižovat tlak na ECB k brzkému zpřísňování."],["Co sledovat dál","Zveřejnění zápisu z posledního zasedání Federálního rezervního systému a jeho interpretaci trhem, zejména s ohledem na budoucí trajektorii úrokových sazeb a vývoj amerického dolaru."]],"updatedAt":"2026-10-07T11:14:18.992Z","sources":[{"headline":"Gold falls as US Dollar, Treasury yields rebound ahead of Fed Minutes","url":"https://www.fxstreet.com/news/gold-falls-as-us-dollar-treasury-yields-rebound-ahead-of-fed-minutes-202610071045","source":"FXStreet Forex & Commodities News"},{"headline":"ECB’s Pereira: No second-round inflation effects at present","url":"https://www.fxstreet.com/news/ecbs-pereira-no-second-round-inflation-effects-at-present-202610071041","source":"FXStreet Forex & Commodities News"},{"headline":"EUR/USD: Waiting for Fed Minutes","url":"https://www.actionforex.com/contributors/technical-analysis/656680-eur-usd-waiting-for-fed-minutes/","source":"ActionForex"},{"headline":"Swiss Franc retreats further, US Dollar firms up with Fed minutes in focus","url":"https://www.fxstreet.com/news/swiss-franc-retreats-further-us-dollar-firms-up-with-fed-minutes-in-focus-202610071043","source":"FXStreet Forex & Commodities News"},{"headline":"Euro Slides Again as French Bond Relief Lasts One Day, EUR/CAD Kisses 1.6000 Goodbye","url":"https://www.actionforex.com/action-insight/market-overview/656684-euro-slides-again-as-french-bond-relief-lasts-one-day-eur-cad-kisses-1-6000-goodbye/","source":"ActionForex"}]},"hasAI":true}