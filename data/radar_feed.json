/www.ecb.europa.eu//press/key/date/2026/html/ecb.sp260923~87850778f5.en.pdf","tier":1,"publishedAt":"2026-09-23T16:00:00.000Z"}],"bestTier":1,"firstSource":"ECB","firstAt":"2026-09-23T16:00:00.000Z","isAnalysis":false,"hid":"h8xv87d","cat":"CENTRÁLNÍ BANKA","cb":true,"cs":"Digitalizace peněz, plateb a financí","ai":"Tato publikace ECB se zaměřuje na trend digitalizace v oblasti peněz, plateb a financí, což odráží strategický zájem centrálních bank o inovace a budoucí podobu finančního systému.","story":"Centrální banky po celém světě aktivně zkoumají a diskutují o dopadech digitalizace na měnovou politiku, finanční stabilitu a efektivitu platebních systémů.","affects":[["EUR","pos"]],"score":5,"milestone":"","analyzedAt":"2026-09-23T16:41:54.282Z"},{"_tier":2,"id":"rh647d3g","provider":"rss","source":"All News","headline":"U.S. stock futures drift lower as soaring yields, oil prices weigh","url":"https://www.investing.com/news/stock-market-news/us-stock-futures-drift-lower-as-soaring-yields-oil-prices-weigh-4916485","isAnalysis":false,"publishedAt":"2026-09-25T00:53:39.000Z","image":"https://content-media.investing.com/news/LYNXMPEM531LT_1200_L.jpg","srcCount":1,"sources":[{"source":"All News","url":"https://www.investing.com/news/stock-market-news/us-stock-futures-drift-lower-as-soaring-yields-oil-prices-weigh-4916485","tier":2,"publishedAt":"2026-09-25T00:53:39.000Z"}],"bestTier":2,"firstSource":"All News","firstAt":"2026-09-25T00:53:39.000Z","hid":"htboa1z","cat":"KOMODITY","cb":false,"cs":"","ai":"","story":"","affects":[["Oil"]],"score":3,"milestone":""},{"_tier":2,"id":"rhitquqk","provider":"rss","source":"All News","headline":"Chile’s Escondida mine gradually resumes operations after fatal accident","url":"https://www.investing.com/news/stock-market-news/chiles-escondida-mine-gradually-resumes-operations-after-fatal-accident-4916465","isAnalysis":false,"publishedAt":"2026-09-25T00:48:24.000Z","image":"https://content-media.investing.com/trkd-images/LYNXMPEM8O