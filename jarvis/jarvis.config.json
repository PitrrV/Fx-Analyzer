{
  "assistant": {
    "name": "JARVIS",
    "shortName": "J",
    "wakeWord": "jarvis",
    "language": "cs",
    "persona": "Jsi osobní AI agent svého uživatele. Mluvíš přirozenou češtinou, stručně a věcně, bez omáčky. Když úkol vyžaduje nástroj, použiješ ho. Když ne, prostě odpovíš."
  },

  "models": {
    "provider": "auto",
    "roles": {
      "primary":   { "provider": "anthropic", "model": "claude-opus-5",        "effort": "high" },
      "fast":      { "provider": "anthropic", "model": "claude-haiku-4-5",     "effort": "low" },
      "coding":    { "provider": "anthropic", "model": "claude-opus-5",        "effort": "xhigh" },
      "secondary": { "provider": "anthropic", "model": "claude-sonnet-5",      "effort": "medium" }
    },
    "maxTokens": 8000
  },

  "features": {
    "tools": true,
    "memory": true,
    "voice": false,
    "streaming": true
  },

  "tools": {
    "enabled": [
      "filesystem.list_files",
      "filesystem.read_file",
      "system.open_path",
      "fx_analyzer.status"
    ],
    "disabled": []
  },

  "security": {
    "allowedRoots": ["..", "../../Fundamet-app"],
    "confirmDestructive": true,
    "confirmTimeoutMs": 120000,
    "maxToolCallsPerTurn": 8,
    "maxFileBytes": 200000
  },

  "memory": {
    "shortTermTurns": 30,
    "dir": "server/memory/store"
  },

  "server": {
    "port": 4177,
    "host": "127.0.0.1"
  }
}
